{
  "manifest_version": 3,
  "name": "AI Adelaide - Missed Call Calculator",
  "version": "1.0.0",
  "description": "Calculate how much revenue your business loses to missed calls. Simple calculator for tradies and small business owners in Adelaide.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AI Adelaide - Missed Call Calculator"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}